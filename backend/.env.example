# Local dev points at the docker-compose Postgres (host port 5433).
# For production (Neon/Render/etc.) replace with your hosted connection string.
DATABASE_URL="postgresql://crm:crm@localhost:5433/school_crm?schema=public"

# Change this to a long random string in production.
JWT_SECRET="dev-change-me-to-a-long-random-string"

PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN="http://localhost:5173"

# Seed admin (used by prisma/seed.js on first run).
SEED_ADMIN_EMAIL="admin@schoolcrm.local"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_NAME="Super Admin"
